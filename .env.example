# ── LLM ──
# 분석은 서버 머신에 로그인된 `claude` CLI(`claude -p`)로 돈다. ANTHROPIC_API_KEY는 쓰지 않는다
# (남아 있으면 CLI의 로그인 경로를 가로채지 않도록 자식 프로세스에서 지운다).
# 헤드리스 서버라면 `claude setup-token`으로 만든 토큰을 넣는다 (선택).
# CLAUDE_CODE_OAUTH_TOKEN=

# ── 인증 ──
# 세션 토큰 서명 키. 32자 이상 랜덤. 없으면 세션 발급이 꺼진다.
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
GAMDO_SESSION_SECRET=
# 1/true/yes면 세션 없는 요청을 401로 막는다. 새 앱이 충분히 배포된 뒤에 켠다.
GAMDO_AUTH_REQUIRED=
# 서비스 토큰 (Bearer). 일치하면 항상 통과·uid 제한 없음. 비우면 과도기에 헤더 없는 요청도 통과.
APP_TOKEN=

# ── Firebase (선택) ──
# 서비스 계정 JSON 파일 경로. `pip install -e '.[firebase]'`도 필요. 없으면 /api/firebase-token은 503.
FIREBASE_SERVICE_ACCOUNT=

# ── Instagram API (Meta Developer Console에서 발급) ──
INSTAGRAM_CLIENT_ID=your-instagram-client-id
INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret

# ── 서버 자원 ──
# 요청 본문 상한 (MB, 기본 50)
GAMDO_MAX_BODY_MB=50
# 이미지 처리 동시 실행 수 (기본 3)
GAMDO_MAX_CONCURRENT=3
# 비동기 분석 작업 워커 수 (기본 4)
GAMDO_MAX_JOBS=4
# 사진 전달 방식: inline(기본, 이미지 직접 첨부) | read(예전 Read 도구 방식)
GAMDO_VISION_INPUT=inline
# 대기 중인 분석 작업 상한. 넘으면 503 busy (기본 20)
GAMDO_MAX_QUEUED_JOBS=20
# PORT=8000

# ── 개발용 ──
# 1/true/yes면 API 문서(/docs, /redoc, /openapi.json)를 연다. 운영에서는 비워 둔다.
GAMDO_ENABLE_DOCS=
